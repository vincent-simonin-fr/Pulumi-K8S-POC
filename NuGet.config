<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <!--
      <clear /> supprime TOUS les feeds hérités (machine + utilisateur).
      Seul nuget.org est utilisé pour ce projet.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Désactive explicitement le feed Azure Artifacts de tevolys
    pour éviter tout fallback depuis la config machine/utilisateur.
  -->
  <disabledPackageSources>
    <add key="GeolysCore" value="true" />
  </disabledPackageSources>

  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>

</configuration>
