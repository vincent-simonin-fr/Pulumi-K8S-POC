<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pulumi" Version="3.*" />
    <PackageReference Include="Pulumi.Kubernetes" Version="4.*" />
    <!-- Pulumi.Command : applique les CRDs KEDA (TriggerAuthentication, ScaledObject)
         via kubectl, contournant le cache de discovery GVK du provider Kubernetes
         qui ne se rafraîchit pas après l'installation des CRDs par le Helm KEDA. -->
    <PackageReference Include="Pulumi.Command" Version="0.*" />
    <!-- Pulumi.Vault : configuration déclarative de Vault (auth k8s, DB engine, rôles,
         policies) en mode provider (cible prod). Cf. VaultDeclarativeConfigResources.
         Utilisé uniquement quand vault:configMode=provider ; sinon le Job dev (Option A). -->
    <PackageReference Include="Pulumi.Vault" Version="7.10.*" />
  </ItemGroup>

  <!-- Sécurité : Pulumi.Kubernetes tire OpenTelemetry 1.9.0 (vulnérable).
       Ces overrides forcent NuGet à résoudre vers la version patchée. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="[1.15.3,)" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="[1.15.3,)" />
  </ItemGroup>

</Project>
